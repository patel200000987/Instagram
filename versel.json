{
  "functions": {
    "api/download.py": {
      "runtime": "python3.9",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/download",
      "dest": "/api/download.py"
    },
    {
      "src": "/api/health",
      "dest": "/api/download.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/download.py"
    }
  ]
}
